# Python
data/.venv/
__pycache__/
*.pyc
data/.pytest_cache/
data/.mypy_cache/

# Client source material: catalog PDFs and the price list. Too large for git
# (GitHub rejects files over 100 MB) and not ours to publish. See CLAUDE.md.
data/source/

# Pipeline outputs. The JSON/Markdown outputs stay tracked because the site builds
# from them; extracted images and the contact sheet are regenerable from data/source/.
data/out/images/
data/out/contact-sheet.html

# Inventory workbooks with photos embedded in the cells. Extract first with
# data/scripts/extract_xlsx_images.py, then commit docs/sunset-sage/ instead.
*inventory*.xlsx
*Sunset Sage*.xlsx
*sunset*sage*.xlsx

# Dev lead-capture sink — holds names and email addresses.
data/out/leads.jsonl

